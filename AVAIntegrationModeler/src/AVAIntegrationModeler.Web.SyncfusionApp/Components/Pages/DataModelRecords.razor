@page "/datamodelrecords"
@page "/datamodelrecords/{Ds}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using AVAIntegrationModeler.Web.SyncfusionApp.ViewModels.List
@using AVAIntegrationModeler.Contracts
@using AVAIntegrationModeler.Contracts.DTO

<PageTitle>@Localization.SharedResources.DataModelRecords_Title</PageTitle>

<div id="ControlRegion">
    <div style="display:flex; align-items:center; gap:16px; margin-bottom:8px; flex-wrap:wrap">
        <div style="display:flex; align-items:center; gap:8px">
            <label>@Localization.SharedResources.DataModelRecords_ModelLabel:</label>
            <SfDropDownList TItem="DataModelDTO" TValue="Guid?"
                            Placeholder="@(Datasource == Datasource.AVAPlace ? Localization.SharedResources.DataModelRecords_SelectModel : Localization.SharedResources.DataModelRecords_AllModels)"
                            DataSource="@_dataModelList"
                            Value="@SelectedModelId"
                            ValueChanged="@HandleModelChange"
                            AllowFiltering="true"
                            FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                <DropDownListFieldSettings Value="Id" Text="Code"></DropDownListFieldSettings>
            </SfDropDownList>
        </div>

        @if (Datasource == Datasource.Database)
        {
            <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="AddNewRecord" Disabled="@(SelectedModelId == null)">
                @Localization.SharedResources.DataModelRecords_AddRecord
            </SfButton>
            <SfButton CssClass="e-outline" IconCss="e-icons e-export" Type="Button" OnClick="ExportAsync" Disabled="@(SelectedModelId == null)">
                Export ZIP
            </SfButton>
            <SfButton CssClass="e-outline" IconCss="e-icons e-download" Type="Button" OnClick="ExportToXlsAsync" Disabled="@(SelectedModelId == null)">
                Export XLS
            </SfButton>
            <InputFile id="xls-import-input" OnChange="ImportFromXlsAsync" accept=".xlsx" style="display:none" />
            <SfButton CssClass="e-outline" IconCss="e-icons e-import" Type="Button" OnClick="OpenXlsFilePicker" Disabled="@(SelectedModelId == null || _importLoading)">
                @(_importLoading ? "Importuji..." : "Import XLS")
            </SfButton>
        }
    </div>

    @if (Datasource == Datasource.AVAPlace)
    {
        <div class="alert alert-info" style="margin-bottom:8px">
            @Localization.SharedResources.DataModelRecords_AvaPlaceReadOnly
        </div>
    }

    @if (_importResult is not null)
    {
        <div class="alert @(_importResult.Errors.Count == 0 ? "alert-success" : "alert-warning")" style="margin-bottom:8px">
            <strong>Import XLS:</strong>
            vytvořeno @_importResult.CreatedCount, aktualizováno @_importResult.UpdatedCount záznamů.
            @if (_importResult.Errors.Count > 0)
            {
                <ul style="margin:4px 0 0 0">
                    @foreach (var err in _importResult.Errors)
                    {
                        <li>Řádek @err.RowNumber: @err.Message</li>
                    }
                </ul>
            }
        </div>
    }

    @if (Datasource == Datasource.AVAPlace && SelectedModelId == null)
    {
        <div class="alert alert-warning" style="margin-top:8px">
            @Localization.SharedResources.DataModelRecords_SelectModelForAvaPlace
        </div>
    }
    else if (IsLoading)
    {
        <p><em>@Localization.SharedResources.Common_LoadingData</em></p>
    }
    else
    {
        <div style="@(!_gridVisible ? "visibility:hidden" : "")">
        <SfGrid ID="RecordsGrid"
                DataSource="@RecordList"
                @ref="Grid"
                EnableAltRow="false"
                AllowPaging="true"
                AllowFiltering="true"
                AllowSorting="true"
                AllowResizing="true"
                Toolbar="@(new List<string>() { "Search" })">

            <GridSearchSettings IgnoreCase="true"></GridSearchSettings>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar" IgnoreAccent="true"></GridFilterSettings>
            <GridEvents TValue="DataModelRecordListViewModel" OnActionComplete="OnGridActionCompleted"></GridEvents>
            <GridPageSettings PageSizes="true" PageSize="20"></GridPageSettings>
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="Syncfusion.Blazor.Grids.SelectionMode.Row" />

            <GridColumns>
                <GridColumn Type="Syncfusion.Blazor.Grids.ColumnType.CheckBox" Width="50"></GridColumn>
                <GridColumn Field=@nameof(DataModelRecordListViewModel.ModelName) HeaderText="Model" Width="200" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn Field=@nameof(DataModelRecordListViewModel.ExternalId) HeaderText="External ID" Width="300" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn Field=@nameof(DataModelRecordListViewModel.FieldsSummary) HeaderText="@Localization.SharedResources.DataModelRecords_FieldValues" Width="400" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn Field=@nameof(DataModelRecordListViewModel.Id) HeaderText="ID" IsPrimaryKey="true" Width="100" Visible="false"></GridColumn>
                <GridColumn HeaderText="@Localization.SharedResources.Common_Actions" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                    <Template>
                        @{
                            var record = (context as DataModelRecordListViewModel);
                            <div class="action-buttons">
                                @if (Datasource == Datasource.Database)
                                {
                                    <SfButton CssClass="e-small e-round e-outline action-button"
                                              IconCss="e-icons e-edit"
                                              OnClick="@(() => EditRecord(record!))"
                                              title="@Localization.SharedResources.Common_Edit">
                                    </SfButton>
                                    <SfButton CssClass="e-small e-round e-outline action-button e-danger"
                                              IconCss="e-icons e-delete"
                                              OnClick="@(() => DeleteRecordAsync(record!))"
                                              title="@Localization.SharedResources.Common_Delete">
                                    </SfButton>
                                }
                                else
                                {
                                    <SfButton CssClass="e-small e-round e-outline action-button"
                                              IconCss="e-icons e-eye"
                                              OnClick="@(() => ViewRecord(record!))"
                                              title="@Localization.SharedResources.DataModelRecords_View">
                                    </SfButton>
                                }
                            </div>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>

            <GridTemplates>
                <DetailTemplate>
                    @{
                        var record = (context as DataModelRecordListViewModel);
                        <div class="detail-form">
                            <h4>@record!.ExternalId</h4>
                            <div class="fields-section">
                                <div class="fields-grid">
                                    @foreach (var field in record.Fields)
                                    {
                                        <div class="field-card">
                                            <div class="field-header">
                                                <strong>@field.Key</strong>
                                                @if (field.IsLocalized)
                                                {
                                                    <span class="field-type-badge">@Localization.SharedResources.DataModelRecords_Localized</span>
                                                }
                                            </div>
                                            @if (field.IsLocalized)
                                            {
                                                <div class="field-detail"><span class="field-label">CZ:</span> @field.CzechValue</div>
                                                <div class="field-detail"><span class="field-label">EN:</span> @field.EnglishValue</div>
                                            }
                                            else
                                            {
                                                <div class="field-detail">@field.StringValue</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </DetailTemplate>
            </GridTemplates>
        </SfGrid>
        </div>
    }
</div>
