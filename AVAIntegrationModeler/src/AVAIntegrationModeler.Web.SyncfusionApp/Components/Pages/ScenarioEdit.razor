@page "/scenarioedit/{dataSourceAsString}/{scenarioCode}"
@page "/scenarioedit/{dataSourceAsString}"
@rendermode InteractiveServer
@using AVAIntegrationModeler.Contracts.DTO
@using AVAIntegrationModeler.Web.SyncfusionApp.Components.Widgets
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons
@using Microsoft.AspNetCore.Components.Forms
<EditForm Model="_edit" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <h2>@Localization.SharedResources.Scenarios_EditTitle</h2>

        <div class="row">
            <div class="col-12 col-md-6">
                <SfTextBox CssClass="w-100" Placeholder="@Localization.SharedResources.Scenarios_CodePlaceholder" FloatLabelType="FloatLabelType.Always" @bind-Value="_edit.Code"></SfTextBox>
                <ValidationMessage For="@(() => _edit.Code)" />
            </div>
            <div class="col-12 col-md-6">
                <SfTextBox CssClass="w-100"
                           Placeholder="@Localization.SharedResources.Identifier"
                           
                           FloatLabelType="FloatLabelType.Always"
                           @bind-Value="_edit.IdText" Readonly=true>
                </SfTextBox>
                <ValidationMessage For="@(() => _edit.IdText)" />
            </div>
        </div>

        <h4 style="margin-top:16px">@Localization.SharedResources.Common_Name</h4>
        <div class="row">
            <div class="col-12 col-md-6">
                <SfTextBox CssClass="w-100" Placeholder="@Localization.SharedResources.Common_Czech" FloatLabelType="FloatLabelType.Always" @bind-Value="_edit.NameCz"></SfTextBox>
                <ValidationMessage For="@(() => _edit.NameCz)" />
            </div>
            <div class="col-12 col-md-6">
                <SfTextBox CssClass="w-100" Placeholder="@Localization.SharedResources.Common_English" FloatLabelType="FloatLabelType.Always" @bind-Value="_edit.NameEn"></SfTextBox>
                <ValidationMessage For="@(() => _edit.NameEn)" />
            </div>
        </div>

        <h4 style="margin-top:16px">@Localization.SharedResources.Common_Description</h4>
        <div class="row">
            <div class="col-12 col-md-6">
                <SfTextArea CssClass="w-100" Placeholder="@Localization.SharedResources.Common_DescriptionCzech" FloatLabelType="FloatLabelType.Always" @bind-Value="_edit.DescriptionCz" Rows="3"></SfTextArea>
                <ValidationMessage For="@(() => _edit.DescriptionCz)" />
            </div>
            <div class="col-12 col-md-6">
                <SfTextArea CssClass="w-100" Placeholder="Description (EN)" FloatLabelType="FloatLabelType.Always" @bind-Value="_edit.DescriptionEn" Rows="3"></SfTextArea>
                <ValidationMessage For="@(() => _edit.DescriptionEn)" />
            </div>
        </div>

        <h4 style="margin-top:16px">@Localization.SharedResources.Scenarios_LinkedFeatures</h4>
        <div class="row">
            <div class="col-12 col-md-6">
                <label>@Localization.SharedResources.Scenarios_InputFeature</label>
                <SfDropDownList TItem="FeatureDTO" TValue="Guid?" DataSource="@_features"
                                Placeholder="@Localization.SharedResources.Scenarios_SelectInputFeature"
                                @bind-Value="_edit.InputFeatureId" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Code" Value="Id"></DropDownListFieldSettings>
                </SfDropDownList>
                <ValidationMessage For="@(() => _edit.InputFeatureId)" />
            </div>
            <div class="col-12 col-md-6">
                <label>@Localization.SharedResources.Scenarios_OutputFeature</label>
                <SfDropDownList TItem="FeatureDTO" TValue="Guid?" DataSource="@_features"
                                Placeholder="@Localization.SharedResources.Scenarios_SelectOutputFeature"
                                @bind-Value="_edit.OutputFeatureId" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Code" Value="Id"></DropDownListFieldSettings>
                </SfDropDownList>
                <ValidationMessage For="@(() => _edit.OutputFeatureId)" />
            </div>
        </div>

        @if (_saveMessage is not null)
        {
            <div class="alert @(_saveSuccess ? "alert-success" : "alert-danger")" style="margin-top:16px">
                @_saveMessage
            </div>
        }

        <div style="margin-top:16px">
            <SfButton CssClass="e-primary" Type="Submit">@Localization.SharedResources.Common_Save</SfButton>
        </div>
    </div>
</EditForm>
    