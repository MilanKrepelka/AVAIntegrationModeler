@page "/datamodelrecordview/{dataSourceAsString}/{modelId:guid}/{recordId:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AVAIntegrationModeler.Contracts.DTO
@using Syncfusion.Blazor.Buttons

<PageTitle>@Localization.SharedResources.DataModelRecords_ViewTitle</PageTitle>

<div class="container">
    <h2>@Localization.SharedResources.DataModelRecords_ViewTitle</h2>

    @if (IsLoading)
    {
        <p><em>@Localization.SharedResources.DataModelRecords_LoadingSchema</em></p>
    }
    else if (ErrorMessage is not null)
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }
    else if (_record is null)
    {
        <div class="alert alert-warning">Záznam nebyl nalezen.</div>
    }
    else
    {
        <div class="row" style="margin-bottom:16px">
            <div class="col-12 col-md-8">
                <div class="form-group">
                    <label class="text-muted" style="font-size:.8rem">External ID</label>
                    <div class="border rounded p-2 bg-light">@_record.ExternalId</div>
                </div>
            </div>
            @if (_dataModel is not null)
            {
                <div class="col-12 col-md-4">
                    <div class="form-group">
                        <label class="text-muted" style="font-size:.8rem">Model</label>
                        <div class="border rounded p-2 bg-light">@_dataModel.Code — @_dataModel.Name</div>
                    </div>
                </div>
            }
        </div>

        @if (_record.CreatedAt.HasValue || _record.LastSavedAt.HasValue)
        {
            <div class="row" style="margin-bottom:16px">
                @if (_record.CreatedAt.HasValue)
                {
                    <div class="col-12 col-md-6">
                        <div class="form-group">
                            <label class="text-muted" style="font-size:.8rem">Vytvořeno</label>
                            <div class="border rounded p-2 bg-light">@_record.CreatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</div>
                        </div>
                    </div>
                }
                @if (_record.LastSavedAt.HasValue)
                {
                    <div class="col-12 col-md-6">
                        <div class="form-group">
                            <label class="text-muted" style="font-size:.8rem">Naposledy uloženo</label>
                            <div class="border rounded p-2 bg-light">@_record.LastSavedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (_dataModel is not null && _dataModel.Fields.Any())
        {
            <h4 style="margin-top:16px">@Localization.SharedResources.DataModelRecords_RecordFields</h4>

            @foreach (var field in _dataModel.Fields)
            {
                var fieldValue = GetField(field.Name);

                <div class="row" style="margin-bottom:12px">
                    <div class="col-12">
                        <strong>@field.Label (@field.Name)</strong>
                        @if (!string.IsNullOrEmpty(field.Description))
                        {
                            <small class="text-muted"> — @field.Description</small>
                        }
                    </div>
                    @if (field.IsLocalized)
                    {
                        <div class="col-12 col-md-6" style="margin-top:4px">
                            <div class="form-group">
                                <label class="text-muted" style="font-size:.8rem">@Localization.SharedResources.Common_Czech</label>
                                <div class="border rounded p-2 bg-light">@(fieldValue?.CzechValue ?? "")</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6" style="margin-top:4px">
                            <div class="form-group">
                                <label class="text-muted" style="font-size:.8rem">English</label>
                                <div class="border rounded p-2 bg-light">@(fieldValue?.EnglishValue ?? "")</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-12 col-md-6" style="margin-top:4px">
                            <div class="border rounded p-2 bg-light">@(fieldValue?.StringValue ?? "")</div>
                        </div>
                    }
                </div>
            }
        }
        else if (_dataModel is null)
        {
            <p class="text-muted">@Localization.SharedResources.DataModelRecords_NoFields</p>
        }
    }

    <div style="margin-top:16px">
        <SfButton CssClass="e-outline" Type="Button" OnClick="GoBack">@Localization.SharedResources.Common_Back</SfButton>
    </div>
</div>
