@page "/scenarios"
@page "/scenarios/{Ds}"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using AVAIntegrationModeler.Web.SyncfusionApp.ViewModels.List;


<PageTitle>Integrační scénáře</PageTitle>

<div id="ControlRegion">
    <div id="GridContainer">
        <SfGrid ID="Grid"
            DataSource="@ScenariosList"
            @ref="Grid"
            EnableAltRow="false"
            AllowPaging="true"
            AllowFiltering="true"
            AllowSorting="true"
            AllowResizing="true"
            AllowSelection="true"
            Toolbar="@(new List<string>() { "Search" })">

            <Syncfusion.Blazor.Navigations.SfToolbar>
                <Syncfusion.Blazor.Navigations.ToolbarItems>
                    <Syncfusion.Blazor.Navigations.ToolbarItem Text="Přidat scénář" PrefixIcon="e-icons e-add" Id="AddNew" OnClick="AddNewScenario"></Syncfusion.Blazor.Navigations.ToolbarItem>
                </Syncfusion.Blazor.Navigations.ToolbarItems>
            </Syncfusion.Blazor.Navigations.SfToolbar>

            <GridEvents TValue="ScenarioListViewModel"
                        OnActionBegin="OnActionBegin"
                        OnActionComplete="OnActionComplete" />
            <GridSearchSettings IgnoreCase="true"></GridSearchSettings>
            <GridEditSettings AllowAdding="false" AllowEditing="true" AllowDeleting="true" Mode="Syncfusion.Blazor.Grids.EditMode.Normal"></GridEditSettings>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar"></GridFilterSettings>
            <GridPageSettings PageSizes="true" PageSize="20"></GridPageSettings>
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" 
                                   Mode="Syncfusion.Blazor.Grids.SelectionMode.Row">
            </GridSelectionSettings>
            <GridColumns>
                <GridColumn Type='Syncfusion.Blazor.Grids.ColumnType.CheckBox' Width="50"></GridColumn>
                <GridColumn Field=@nameof(ScenarioListViewModel.Code) HeaderText="Kód" Width="120" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn Field="Name.EnglishValue" HeaderText="Název" Width="200" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn Field="Description.EnglishValue" HeaderText="Popis" Width="250" Visible="false" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn Field="InputFeature.Code" HeaderText="Vstupní feature" Width="150" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn Field="OutputFeature.Code" HeaderText="Výstupní feature" Width="150" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn Field=@nameof(ScenarioListViewModel.Id) HeaderText="ID" IsPrimaryKey="true" Width="320" Visible="true">
                    <Template>
                        @{

                            var scenario = (context as ScenarioListViewModel);
                            <div class="id-cell-container">
                                <span class="id-text">@scenario!.Id.ToString()</span>
                                <SfButton CssClass="e-small e-round action-button copy-icon-button"
                                          IconCss="e-icons e-copy"
                                          IsPrimary="false"
                                          OnClick="@(() => CopyToClipboard(scenario.Id.ToString()))"
                                          title="Kopírovat ID do schránky">
                                </SfButton>
                            </div>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Akce" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                    <Template>
                        @{
                            var model = (context as ScenarioListViewModel);
                            <div class="action-buttons">
                                <SfButton CssClass="e-small e-round e-outline action-button"
                                          IconCss="e-icons e-edit"
                                          IsPrimary="false"
                                          OnClick="@(() => EditDataModel(model!))"
                                          title="Editovat">
                                </SfButton>

                                <SfButton CssClass="e-small e-round e-outline action-button"
                                          IconCss="e-icons e-chart-scatter"
                                          IsPrimary="false"
                                          OnClick="@(() => ShowModelMap(model!))"
                                          title="Map">
                                </SfButton>
                            </div>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
            
            <GridTemplates>
                <DetailTemplate>
                    @{
                        var scenario = (context as ScenarioListViewModel);
                        <div class="detail-form">
                            <h4>@scenario!.Code</h4>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Kód:</label>
                                    <SfTextBox Value="@scenario.Code" Placeholder="Kód scénáře" Readonly="true"></SfTextBox>
                                </div>
                                
                                <div class="form-group">
                                    <label>ID:</label>
                                    <div class="input-with-button">
                                        <SfTextBox Value="@scenario.Id.ToString()" Readonly="true" CssClass="id-textbox"></SfTextBox>
                                        <SfButton CssClass="e-small action-button"
                                                  IconCss="e-icons e-copy"
                                                  OnClick="@(() => CopyToClipboard(scenario.Id.ToString()))"
                                                  Content="Kopírovat">
                                        </SfButton>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Název (Česky):</label>
                                    <SfTextBox Value="@scenario.Name.CzechValue" Placeholder="" Readonly="true"></SfTextBox>
                                </div>
                                
                                <div class="form-group">
                                    <label>Název (English):</label>
                                    <SfTextBox Value="@scenario.Name.EnglishValue" Placeholder="" Readonly="true"></SfTextBox>
                                </div>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group full-width">
                                    <label>Popis (Česky):</label>
                                    <SfTextBox @bind-Value="scenario.Description.CzechValue" Placeholder="" Multiline="true" Readonly="true"></SfTextBox>
                                </div>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group full-width">
                                    <label>Popis (English):</label>
                                    <SfTextBox @bind-Value="scenario.Description.EnglishValue" Placeholder="" Multiline="true" Readonly="true"></SfTextBox>
                                </div>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Vstupní feature:</label>
                                    <SfTextBox Value="@scenario.InputFeature.Code" Readonly="true"></SfTextBox>
                                </div>
                                
                                <div class="form-group">
                                    <label>Výstupní feature:</label>
                                    <SfTextBox Value="@scenario.OutputFeature.Code" Readonly="true"></SfTextBox>
                                </div>
                            </div>
                        </div>
                    }
                </DetailTemplate>
            </GridTemplates>

        </SfGrid>
    </div>
</div>

@if (_notification != null)
{
    <div style="position:fixed;top:1.2rem;right:1.2rem;z-index:9999;@(_notificationSuccess?"background:#198754":"background:#dc3545");color:#fff;padding:.5rem 1.1rem;border-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,.18);font-size:.875rem;">
        @(_notificationSuccess ? "✓" : "✗") @_notification
    </div>
}

@if (IsLoading)
{
    <div class="progress-bar-container">
        <div class="progress-bar-indeterminate"></div>
    </div>
}

@code
{
    SfGrid<ScenarioListViewModel>? Grid;
    string? _notification;
    bool _notificationSuccess = true;
    private static readonly FilterSettings _containsFilter = new() { Operator = Syncfusion.Blazor.Operator.Contains };

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task ShowNotification(string message, bool success = true)
    {
        _notificationSuccess = success;
        _notification = message;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        _notification = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        await ShowNotification($"ID zkopírováno: {text.Substring(0, 8)}...");
    }

    private async Task ShowModelMap(ScenarioListViewModel scenario)
    {
        // Open Data Model Map in a new browser tab
        var url = NavigationManager.ToAbsoluteUri($"/scenariomap/{this.Datasource}/{scenario.Code}").ToString();
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task EditDataModel(ScenarioListViewModel scenario)
    {
        var url = NavigationManager.ToAbsoluteUri($"/scenarioedit/{this.Datasource}/{scenario.Code}").ToString();
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private void OnActionBegin(ActionEventArgs<ScenarioListViewModel> args)
    {
        IsLoading = true;
    }

    private void OnActionComplete(ActionEventArgs<ScenarioListViewModel> args)
    {
        IsLoading = false;
    }
}
