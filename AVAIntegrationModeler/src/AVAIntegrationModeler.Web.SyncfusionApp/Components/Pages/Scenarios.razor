@page "/scenarios"
@rendermode InteractiveServer
@using AVAIntegrationModeler.Web.SyncfusionApp.Components.Widgets
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Notifications
@using AVAIntegrationModeler.Web.SyncfusionApp.ViewModels.List;

<PageTitle>Integrační scénáře</PageTitle>

<div id="ControlRegion">
    @* <DataSourceSelector @bind-Selected="SelectedDataSource" OnChanged="@HandleDataSourceChange" LabelText="Zdroj dat:"></DataSourceSelector> *@

    <SfGrid ID="Grid" 
        DataSource="@ScenariosList" 
        @ref="Grid"
        EnableAltRow="false"
        AllowPaging="true"
        AllowFiltering="true"
        AllowSorting="true"
        AllowResizing="true"
        AllowSelection="true"
        Toolbar="@(new List<string>() { "Search"})">

        <GridSearchSettings IgnoreCase="true"></GridSearchSettings>
        <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="Syncfusion.Blazor.Grids.EditMode.Normal"></GridEditSettings>
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar"></GridFilterSettings>
        <GridPageSettings PageSizes="true" PageSize="20"></GridPageSettings>
        <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" 
                               Mode="Syncfusion.Blazor.Grids.SelectionMode.Row">
        </GridSelectionSettings>
        <GridEvents OnToolbarClick="ToolbarClick" TValue="ScenarioListViewModel"></GridEvents>
        <GridColumns>
            <GridColumn Type='Syncfusion.Blazor.Grids.ColumnType.CheckBox' Width="50"></GridColumn>
            <GridColumn Field=@nameof(ScenarioListViewModel.Code) HeaderText="Kód" Width="120"></GridColumn>
            <GridColumn Field="Name.EnglishValue" HeaderText="Název" Width="200"></GridColumn>
            <GridColumn Field="Description.EnglishValue" HeaderText="Popis" Width="250" Visible="false"></GridColumn>
            <GridColumn Field="InputFeature.Code" HeaderText="Vstupní feature" Width="150"></GridColumn>
            <GridColumn Field="OutputFeature.Code" HeaderText="Výstupní feature" Width="150"></GridColumn>
            <GridColumn Field=@nameof(ScenarioListViewModel.Id) HeaderText="ID" IsPrimaryKey="true" Width="320" Visible="true">
                <Template>
                    @{

                        var scenario = (context as ScenarioListViewModel);
                        <div class="id-cell-container">
                            <span class="id-text">@scenario!.Id.ToString()</span>
                            <SfButton CssClass="e-small e-round action-button copy-icon-button"
                                      IconCss="e-icons e-copy"
                                      IsPrimary="false"
                                      OnClick="@(() => CopyToClipboard(scenario.Id.ToString()))"
                                      title="Kopírovat ID do schránky">
                            </SfButton>
                        </div>
                    }
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Akce" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                <Template>
                    @{
                        var model = (context as DataModelListViewModel);
                        <div class="action-buttons">
                            <SfButton CssClass="e-small e-round e-outline action-button"
                                      IconCss="e-icons e-edit"
                                      IsPrimary="false"
                                      OnClick="@(() => EditDataModel(model!))"
                                      title="Editovat">
                            </SfButton>

                            <SfButton CssClass="e-small e-round e-outline action-button"
                                      IconCss="e-icons e-chart-scatter"
                                      IsPrimary="false"
                                      OnClick="@(() => ShowModelMap(model!))"
                                      title="Map">
                            </SfButton>
                        </div>
                    }
                </Template>
            </GridColumn>
        </GridColumns>
        
        <GridTemplates>
            <DetailTemplate>
                @{
                    var scenario = (context as ScenarioListViewModel);
                    <div class="detail-form">
                        <h4>@scenario!.Code</h4>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label>Kód:</label>
                                <SfTextBox Value="@scenario.Code" Placeholder="Kód scénáře" Readonly="true"></SfTextBox>
                            </div>
                            
                            <div class="form-group">
                                <label>ID:</label>
                                <div class="input-with-button">
                                    <SfTextBox Value="@scenario.Id.ToString()" Readonly="true" CssClass="id-textbox"></SfTextBox>
                                    <SfButton CssClass="e-small action-button"
                                              IconCss="e-icons e-copy"
                                              OnClick="@(() => CopyToClipboard(scenario.Id.ToString()))"
                                              Content="Kopírovat">
                                    </SfButton>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label>Název (Česky):</label>
                                <SfTextBox Value="@scenario.Name.CzechValue" Placeholder="" Readonly="true"></SfTextBox>
                            </div>
                            
                            <div class="form-group">
                                <label>Název (English):</label>
                                <SfTextBox Value="@scenario.Name.EnglishValue" Placeholder="" Readonly="true"></SfTextBox>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group full-width">
                                <label>Popis (Česky):</label>
                                <SfTextBox @bind-Value="scenario.Description.CzechValue" Placeholder="" Multiline="true" Readonly="true"></SfTextBox>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group full-width">
                                <label>Popis (English):</label>
                                <SfTextBox @bind-Value="scenario.Description.EnglishValue" Placeholder="" Multiline="true" Readonly="true"></SfTextBox>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label>Vstupní feature:</label>
                                <SfTextBox Value="@scenario.InputFeature.Code" Readonly="true"></SfTextBox>
                            </div>
                            
                            <div class="form-group">
                                <label>Výstupní feature:</label>
                                <SfTextBox Value="@scenario.OutputFeature.Code" Readonly="true"></SfTextBox>
                            </div>
                        </div>
                    </div>
                }
            </DetailTemplate>
        </GridTemplates>

    </SfGrid>
</div>

<SfToast @ref="ToastObj" Title="Zkopírováno" Timeout="3000" ShowCloseButton="true">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

@code
{
    SfGrid<ScenarioListViewModel>? Grid;
    SfToast? ToastObj;

    public void ToolbarClick(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        if (args.Item.Id == "Grid_excelexport")
        {
            //this.Grid?.ExportToExcelAsync();
        }
    }

    //private string SelectedDataSource = "Database";

    private async Task HandleDataSourceChange(Contracts.Datasource newValue)
    {
        this.Datasource = newValue;
        await LoadItemsAsync();
        await Grid!.Refresh();
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        
        // Zobrazit toast s ID hodnotou
        await ShowToast($"ID zkopírováno: {text.Substring(0, 8)}...");
    }

    private async Task ShowToast(string message)
    {
        if (ToastObj != null)
        {
            var toastModel = new ToastModel
            {
                Content = message,
                CssClass = "e-toast-success",
                Icon = "e-success toast-icons"
            };
            await ToastObj.ShowAsync(toastModel);
        }
    }
    private async Task ShowModelMap(DataModelListViewModel model)
    {
        // Open Data Model Map in a new browser tab
        var url = NavigationManager.ToAbsoluteUri($"/datamodelmap/{model.Id}").ToString();
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private void EditDataModel(DataModelListViewModel model)
    {
        // TODO: Implementovat editaci - například přesměrování na edit stránku
        NavigationManager.NavigateTo($"/datamodels/edit/{model.Id}", true);

        // nebo otevřít dialog pro editaci
    }
}
