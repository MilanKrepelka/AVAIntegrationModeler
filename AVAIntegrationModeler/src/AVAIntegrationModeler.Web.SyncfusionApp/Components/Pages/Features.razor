@page "/features"
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using AVAIntegrationModeler.Web.SyncfusionApp.ViewModels.List;

<PageTitle>@Localization.SharedResources.Features_Title</PageTitle>

<div id="ControlRegion">
    <SfGrid ID="Grid"
        DataSource="@FeaturesList"
        @ref="Grid"
        EnableAltRow= "false"
        AllowPaging="true"
        AllowFiltering="true"
        AllowSorting="true"
        AllowResizing="true"
        AllowSelection="true"
        Toolbar="@(new List<string>() { "Search"})">

        <GridSearchSettings IgnoreCase="true"></GridSearchSettings>
        <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="Syncfusion.Blazor.Grids.EditMode.Normal"></GridEditSettings>
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar" IgnoreAccent="true"></GridFilterSettings>
        <GridPageSettings PageSizes="true" PageSize="20"></GridPageSettings>
        <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings>
        <GridEvents OnToolbarClick="ToolbarClick" TValue="FeatureListViewModel"></GridEvents>
        <GridColumns>
            <GridColumn Type='Syncfusion.Blazor.Grids.ColumnType.CheckBox' Width="50"></GridColumn>
            <GridColumn Field=@nameof(FeatureListViewModel.Code) HeaderText="@Localization.SharedResources.Common_Code" Width="120" FilterSettings="@_containsFilter"></GridColumn>
            <GridColumn Field="Name.EnglishValue" HeaderText="@Localization.SharedResources.Common_Name" Width="200" FilterSettings="@_containsFilter"></GridColumn>
            <GridColumn Field="Description.EnglishValue" HeaderText="@Localization.SharedResources.Common_Description" Width="250" FilterSettings="@_containsFilter"></GridColumn>
            <GridColumn Field=@nameof(FeatureListViewModel.IncludedFeaturesText) HeaderText="@Localization.SharedResources.Features_IncludedFeaturesColumn" Width="200" FilterSettings="@_containsFilter"></GridColumn>
            <GridColumn Field=@nameof(FeatureListViewModel.IncludedModelsText) HeaderText="@Localization.SharedResources.Features_IncludedModelsColumn" Width="200" FilterSettings="@_containsFilter"></GridColumn>
            <GridColumn Field=@nameof(FeatureListViewModel.Id) HeaderText="ID" IsPrimaryKey="true" Width="250" Visible="false"></GridColumn>
        </GridColumns>

        <GridTemplates>
            <DetailTemplate>
                @{
                    var feature = (context as FeatureListViewModel);
                    <div class="detail-form">
                        <h4>@feature!.Code</h4>

                        <div class="form-row">
                            <div class="form-group">
                                <label>@Localization.SharedResources.Common_Code:</label>
                                <SfTextBox Value="@feature.Code" Placeholder="@Localization.SharedResources.Features_CodePlaceholder"></SfTextBox>
                            </div>

                            <div class="form-group">
                                <label>ID:</label>
                                <SfTextBox Value="@feature.Id.ToString()" Readonly="true"></SfTextBox>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>@Localization.SharedResources.Common_NameCzech:</label>
                                <SfTextBox Value="@feature.Name.CzechValue" Placeholder="@Localization.SharedResources.Features_NameCzechPlaceholder"></SfTextBox>
                            </div>

                            <div class="form-group">
                                <label>@Localization.SharedResources.Common_NameEnglish:</label>
                                <SfTextBox Value="@feature.Name.EnglishValue" Placeholder="English name"></SfTextBox>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group full-width">
                                <label>@Localization.SharedResources.Common_DescriptionCzech:</label>
                                <SfTextBox @bind-Value="feature.Description.CzechValue" Placeholder="@Localization.SharedResources.Features_DescriptionCzechPlaceholder" Multiline="true"></SfTextBox>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group full-width">
                                <label>@Localization.SharedResources.Common_DescriptionEnglish:</label>
                                <SfTextBox @bind-Value="feature.Description.EnglishValue" Placeholder="English description" Multiline="true"></SfTextBox>
                            </div>
                        </div>

                        @if (feature.IncludedFeatures?.Any() == true)
                        {
                            <div class="form-row">
                                <div class="form-group full-width">
                                    <label>@Localization.SharedResources.Features_IncludedFeatures:</label>
                                    <div class="included-items">
                                        @foreach (var includedFeature in feature.IncludedFeatures)
                                        {
                                            <span class="badge">@includedFeature.Feature.Code</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        @if (feature.IncludedModels?.Any() == true)
                        {
                            <div class="form-row">
                                <div class="form-group full-width">
                                    <label>@Localization.SharedResources.Features_IncludedDataModels:</label>
                                    <div class="included-items">
                                        @foreach (var includedModel in feature.IncludedModels)
                                        {
                                            <span class="badge">@includedModel.DataModel.Code</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </DetailTemplate>
        </GridTemplates>

    </SfGrid>
</div>

@code
{
    SfGrid<FeatureListViewModel>? Grid;
    private static readonly FilterSettings _containsFilter = new() { Operator = Syncfusion.Blazor.Operator.Contains };

    public void ToolbarClick(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        if (args.Item.Id == "Grid_excelexport")
        {
            //this.Grid?.ExportToExcelAsync();
        }
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }
}
