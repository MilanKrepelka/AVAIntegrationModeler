@page "/features"
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using AVAIntegrationModeler.Web.SyncfusionApp.ViewModels.List;

<PageTitle>Integra�n� Features</PageTitle>

<div id="ControlRegion">
    <SfGrid ID="Grid" 
        DataSource="@FeaturesList" 
        @ref="Grid"
        EnableAltRow= "false"
        AllowPaging="true"
        AllowFiltering="true"
        AllowSorting="true"
        AllowResizing="true"
        AllowSelection="true"
        Toolbar="@(new List<string>() { "Search"})">

        <GridSearchSettings IgnoreCase="true"></GridSearchSettings>
        <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="Syncfusion.Blazor.Grids.EditMode.Normal"></GridEditSettings>
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar"></GridFilterSettings>
        <GridPageSettings PageSizes="true" PageSize="20"></GridPageSettings>
        <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings>
        <GridEvents OnToolbarClick="ToolbarClick" TValue="FeatureListViewModel"></GridEvents>
        <GridColumns>
            <GridColumn Type='Syncfusion.Blazor.Grids.ColumnType.CheckBox' Width="50"></GridColumn>
            <GridColumn Field=@nameof(FeatureListViewModel.Code) HeaderText="K�d" Width="120" FilterSettings="@_containsFilter"></GridColumn>
            <GridColumn Field="Name.EnglishValue" HeaderText="N�zev" Width="200" FilterSettings="@_containsFilter"></GridColumn>
            <GridColumn Field="Description.EnglishValue" HeaderText="Popis" Width="250" FilterSettings="@_containsFilter"></GridColumn>
            <GridColumn Field=@nameof(FeatureListViewModel.IncludedFeaturesText) HeaderText="Zahrnut� Features" Width="200" FilterSettings="@_containsFilter"></GridColumn>
            <GridColumn Field=@nameof(FeatureListViewModel.IncludedModelsText) HeaderText="Zahrnut� Modely" Width="200" FilterSettings="@_containsFilter"></GridColumn>
            <GridColumn Field=@nameof(FeatureListViewModel.Id) HeaderText="ID" IsPrimaryKey="true" Width="250" Visible="false"></GridColumn>
        </GridColumns>
        
        <GridTemplates>
            <DetailTemplate>
                @{
                    var feature = (context as FeatureListViewModel);
                    <div class="detail-form">
                        <h4>@feature!.Code</h4>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label>K�d:</label>
                                <SfTextBox Value="@feature.Code" Placeholder="K�d feature"></SfTextBox>
                            </div>
                            
                            <div class="form-group">
                                <label>ID:</label>
                                <SfTextBox Value="@feature.Id.ToString()" Readonly="true"></SfTextBox>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label>N�zev (�esky):</label>
                                <SfTextBox Value="@feature.Name.CzechValue" Placeholder="�esk� n�zev"></SfTextBox>
                            </div>
                            
                            <div class="form-group">
                                <label>N�zev (English):</label>
                                <SfTextBox Value="@feature.Name.EnglishValue" Placeholder="English name"></SfTextBox>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group full-width">
                                <label>Popis (�esky):</label>
                                <SfTextBox @bind-Value="feature.Description.CzechValue" Placeholder="�esk� popis" Multiline="true"></SfTextBox>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group full-width">
                                <label>Popis (English):</label>
                                <SfTextBox @bind-Value="feature.Description.EnglishValue" Placeholder="English description" Multiline="true"></SfTextBox>
                            </div>
                        </div>
                        
                        @if (feature.IncludedFeatures?.Any() == true)
                        {
                            <div class="form-row">
                                <div class="form-group full-width">
                                    <label>Zahrnut� Features:</label>
                                    <div class="included-items">
                                        @foreach (var includedFeature in feature.IncludedFeatures)
                                        {
                                            <span class="badge">@includedFeature.Feature.Code</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @if (feature.IncludedModels?.Any() == true)
                        {
                            <div class="form-row">
                                <div class="form-group full-width">
                                    <label>Zahrnut� Data Modely:</label>
                                    <div class="included-items">
                                        @foreach (var includedModel in feature.IncludedModels)
                                        {
                                            <span class="badge">@includedModel.DataModel.Code</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </DetailTemplate>
        </GridTemplates>

    </SfGrid>
</div>

