@page "/deployments"
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using AVAIntegrationModeler.Web.SyncfusionApp.ViewModels.List

<PageTitle>@Localization.SharedResources.Deployments_Title</PageTitle>

<div id="ControlRegion">
    <div id="GridContainer">
        <SfGrid ID="Grid"
                DataSource="@DeploymentsList"
                @ref="Grid"
                EnableAltRow="false"
                AllowPaging="true"
                AllowFiltering="true"
                AllowSorting="true"
                AllowResizing="true"
                AllowSelection="true"
                Toolbar="@(new List<string>() { "Search" })">

            <Syncfusion.Blazor.Navigations.SfToolbar>
                <Syncfusion.Blazor.Navigations.ToolbarItems>
                    <Syncfusion.Blazor.Navigations.ToolbarItem Text="@Localization.SharedResources.Deployments_AddNew" PrefixIcon="e-icons e-add" Id="AddNew" OnClick="AddNew"></Syncfusion.Blazor.Navigations.ToolbarItem>
                </Syncfusion.Blazor.Navigations.ToolbarItems>
            </Syncfusion.Blazor.Navigations.SfToolbar>

            <GridSearchSettings IgnoreCase="true"></GridSearchSettings>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar" IgnoreAccent="true"></GridFilterSettings>
            <GridPageSettings PageSizes="true" PageSize="20"></GridPageSettings>

            <GridColumns>
                <GridColumn Field=@nameof(DeploymentListViewModel.Code) HeaderText="@Localization.SharedResources.Common_Code" Width="150" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn Field=@nameof(DeploymentListViewModel.Name) HeaderText="@Localization.SharedResources.Common_Name" Width="300" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn Field=@nameof(DeploymentListViewModel.DataModelCount) HeaderText="@Localization.SharedResources.Areas_DataModelsColumn" Width="150"></GridColumn>
                <GridColumn Field=@nameof(DeploymentListViewModel.LastDeploymentDateTime) HeaderText="@Localization.SharedResources.Deployments_LastDeployment" Width="180" Type="ColumnType.DateTime" Format="dd.MM.yyyy HH:mm"></GridColumn>
                <GridColumn Field=@nameof(DeploymentListViewModel.Id) HeaderText="ID" IsPrimaryKey="true" Width="1" Visible="false" AllowSearching="false"></GridColumn>
                <GridColumn Field=@nameof(DeploymentListViewModel.IdText) HeaderText="ID Text" Width="1" Visible="false" AllowSearching="true" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn HeaderText="@Localization.SharedResources.Common_Actions" Width="165" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                    <Template>
                        @{
                            var model = (context as DeploymentListViewModel);
                            <div class="action-buttons">
                                <SfButton CssClass="e-small e-round e-outline action-button"
                                          IconCss="e-icons e-edit"
                                          IsPrimary="false"
                                          OnClick="@(() => EditDeployment(model!))"
                                          title="@Localization.SharedResources.Common_Edit">
                                </SfButton>
                                <SfButton CssClass="e-small e-round e-outline action-button"
                                          IconCss="e-icons e-copy"
                                          IsPrimary="false"
                                          OnClick="@(() => CopyToClipboard(model!.Id.ToString()))"
                                          title="@Localization.SharedResources.Common_CopyIdToClipboard">
                                </SfButton>
                                <SfButton CssClass="e-small e-round e-outline action-button"
                                          IconCss="e-icons e-export"
                                          IsPrimary="false"
                                          OnClick="@(() => ExportDeploymentAsync(model!))"
                                          title="@Localization.SharedResources.Deployments_ExportTitle">
                                </SfButton>
                                <SfButton CssClass="e-small e-round e-outline action-button e-danger"
                                          IconCss="e-icons e-delete"
                                          IsPrimary="false"
                                          OnClick="@(() => DeleteDeploymentAsync(model!))"
                                          title="@Localization.SharedResources.Common_Delete">
                                </SfButton>
                            </div>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
</div>

@if (_notification != null)
{
    <div style="position:fixed;top:1.2rem;right:1.2rem;z-index:9999;@(_notificationSuccess?"background:#198754":"background:#dc3545");color:#fff;padding:.5rem 1.1rem;border-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,.18);font-size:.875rem;">
        @(_notificationSuccess ? "✓" : "✗") @_notification
    </div>
}

@if (IsLoading)
{
    <div class="progress-bar-container">
        <div class="progress-bar-indeterminate"></div>
    </div>
}

@code {
    SfGrid<DeploymentListViewModel>? Grid;
    string? _notification;
    bool _notificationSuccess = true;
    private static readonly FilterSettings _containsFilter = new() { Operator = Syncfusion.Blazor.Operator.Contains };

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task ShowNotification(string message, bool success = true)
    {
        _notificationSuccess = success;
        _notification = message;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        _notification = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        await ShowNotification(string.Format(Localization.SharedResources.Common_IdCopied, text.Substring(0, 8)));
    }

    private void EditDeployment(DeploymentListViewModel deployment)
    {
        NavigationManager.NavigateTo($"/deploymentedit/{deployment.Code}");
    }
}
