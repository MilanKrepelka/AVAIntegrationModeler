@page "/areas"
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using AVAIntegrationModeler.Web.SyncfusionApp.ViewModels.List

<PageTitle>@Localization.SharedResources.Areas_Title</PageTitle>

<div id="ControlRegion">
    <div id="GridContainer" style="@(!_gridVisible ? "visibility:hidden" : "")">
        <SfGrid ID="Grid"
                DataSource="@AreasList"
                @ref="Grid"
                EnableAltRow="false"
                AllowPaging="true"
                AllowFiltering="true"
                AllowSorting="true"
                AllowResizing="true"
                AllowSelection="true"
                AllowDetail="true"
                Toolbar="@(new List<string>() { "Search" })">

            <Syncfusion.Blazor.Navigations.SfToolbar>
                <Syncfusion.Blazor.Navigations.ToolbarItems>
                    <Syncfusion.Blazor.Navigations.ToolbarItem Text="@Localization.SharedResources.Areas_AddNew" PrefixIcon="e-icons e-add" Id="AddNew" OnClick="AddNew"></Syncfusion.Blazor.Navigations.ToolbarItem>
                </Syncfusion.Blazor.Navigations.ToolbarItems>
            </Syncfusion.Blazor.Navigations.SfToolbar>

            <GridSearchSettings IgnoreCase="true"></GridSearchSettings>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar" IgnoreAccent="true"></GridFilterSettings>
            <GridEvents TValue="AreaListViewModel" OnActionComplete="OnGridActionCompleted"></GridEvents>
            <GridPageSettings PageSizes="true" PageSize="20"></GridPageSettings>

            <GridColumns>
                <GridColumn Field=@nameof(AreaListViewModel.Code) HeaderText="@Localization.SharedResources.Common_Code" Width="150" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn Field=@nameof(AreaListViewModel.Name) HeaderText="@Localization.SharedResources.Common_Name" Width="300" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn Field=@nameof(AreaListViewModel.DataModelsText) HeaderText="@Localization.SharedResources.Areas_DataModelsColumn" Width="400" FilterSettings="@_containsFilter"></GridColumn>
                <GridColumn HeaderText="@Localization.SharedResources.Common_Actions" Width="140" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                    <Template>
                        @{
                            var model = (context as AreaListViewModel);
                            <div class="action-buttons">
                                <SfButton CssClass="e-small e-round e-outline action-button"
                                          IconCss="e-icons e-edit"
                                          IsPrimary="false"
                                          OnClick="@(() => EditArea(model!))"
                                          title="@Localization.SharedResources.Common_Edit">
                                </SfButton>
                                <SfButton CssClass="e-small e-round e-outline action-button"
                                          IconCss="e-icons e-chart-scatter"
                                          IsPrimary="false"
                                          OnClick="@(() => NavigationManager.NavigateTo($"/areamap/{model!.Id}"))"
                                          title="@Localization.SharedResources.Common_ShowMap">
                                </SfButton>
                                <SfButton CssClass="e-small e-round e-outline action-button e-danger"
                                          IconCss="e-icons e-delete"
                                          IsPrimary="false"
                                          OnClick="@(() => DeleteAreaAsync(model!))"
                                          title="@Localization.SharedResources.Common_Delete">
                                </SfButton>
                            </div>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>

            <GridTemplates>
                <DetailTemplate>
                    @{
                        var area = (context as AreaListViewModel);
                        <div class="detail-form">
                            @if (area!.DataModels.Count == 0)
                            {
                                <p style="color:var(--bs-secondary,#6c757d);font-style:italic">@Localization.SharedResources.Areas_NoDataModels</p>
                            }
                            else
                            {
                                <div class="fields-section">
                                    <h5>@string.Format(Localization.SharedResources.Areas_DataModelsCount, area.DataModels.Count)</h5>
                                    <div class="fields-grid">
                                        @foreach (var model in area.DataModels.OrderBy(m => m.Code))
                                        {
                                            <div class="field-card">
                                                <div class="field-header">
                                                    <strong>@model.Code</strong>
                                                    @if (model.IsAggregateRoot)
                                                    {
                                                        <span class="field-type-badge">Aggregate Root</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(model.Name))
                                                {
                                                    <div class="field-detail">
                                                        <span class="field-label">@Localization.SharedResources.Common_Name:</span> @model.Name
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(model.Description))
                                                {
                                                    <div class="field-detail">
                                                        <span class="field-label">@Localization.SharedResources.Common_Description:</span> @model.Description
                                                    </div>
                                                }
                                                <div class="field-flags">
                                                    <span class="flag-badge">@string.Format(Localization.SharedResources.Areas_FieldsCount, model.Fields.Count)</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </DetailTemplate>
            </GridTemplates>

        </SfGrid>
    </div>
</div>

@if (_notification != null)
{
    <div style="position:fixed;top:1.2rem;right:1.2rem;z-index:9999;@(_notificationSuccess?"background:#198754":"background:#dc3545");color:#fff;padding:.5rem 1.1rem;border-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,.18);font-size:.875rem;">
        @(_notificationSuccess ? "✓" : "✗") @_notification
    </div>
}

@if (IsLoading)
{
    <div class="progress-bar-container">
        <div class="progress-bar-indeterminate"></div>
    </div>
}

@code {
    SfGrid<AreaListViewModel>? Grid;
    string? _notification;
    bool _notificationSuccess = true;
    private static readonly FilterSettings _containsFilter = new() { Operator = Syncfusion.Blazor.Operator.Contains };

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task ShowNotification(string message, bool success = true)
    {
        _notificationSuccess = success;
        _notification = message;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        _notification = null;
        await InvokeAsync(StateHasChanged);
    }

    private void EditArea(AreaListViewModel area)
    {
        NavigationManager.NavigateTo($"/areaedit/{area.Code}");
    }

    private void OnGridActionCompleted(ActionEventArgs<AreaListViewModel> args)
    {
        if (args.RequestType is Syncfusion.Blazor.Grids.Action.Filtering or Syncfusion.Blazor.Grids.Action.ClearFiltering)
            _filterState.Save("Areas", Grid?.FilterSettings?.Columns);
    }
}
