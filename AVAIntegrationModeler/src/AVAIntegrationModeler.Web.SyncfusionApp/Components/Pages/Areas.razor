@page "/areas"
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Notifications
@using AVAIntegrationModeler.Web.SyncfusionApp.ViewModels.List

<PageTitle>Oblasti</PageTitle>

<div id="ControlRegion">
    <div id="GridContainer">
        <SfGrid ID="Grid"
                DataSource="@AreasList"
                @ref="Grid"
                EnableAltRow="false"
                AllowPaging="true"
                AllowFiltering="true"
                AllowSorting="true"
                AllowResizing="true"
                AllowSelection="true">

            <Syncfusion.Blazor.Navigations.SfToolbar>
                <Syncfusion.Blazor.Navigations.ToolbarItems>
                    <Syncfusion.Blazor.Navigations.ToolbarItem Text="Přidat oblast" PrefixIcon="e-icons e-add" Id="AddNew" OnClick="AddNew"></Syncfusion.Blazor.Navigations.ToolbarItem>
                </Syncfusion.Blazor.Navigations.ToolbarItems>
            </Syncfusion.Blazor.Navigations.SfToolbar>

            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar"></GridFilterSettings>
            <GridPageSettings PageSizes="true" PageSize="20"></GridPageSettings>

            <GridColumns>
                <GridColumn Field=@nameof(AreaListViewModel.Code) HeaderText="Kód" Width="150"></GridColumn>
                <GridColumn Field=@nameof(AreaListViewModel.Name) HeaderText="Název" Width="300"></GridColumn>
                <GridColumn Field=@nameof(AreaListViewModel.Id) HeaderText="ID" IsPrimaryKey="true" Width="320" Visible="true">
                    <Template>
                        @{
                            var area = (context as AreaListViewModel);
                            <div class="id-cell-container">
                                <span class="id-text">@area!.Id.ToString()</span>
                                <SfButton CssClass="e-small e-round action-button copy-icon-button"
                                          IconCss="e-icons e-copy"
                                          IsPrimary="false"
                                          OnClick="@(() => CopyToClipboard(area.Id.ToString()))"
                                          title="Kopírovat ID do schránky">
                                </SfButton>
                            </div>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Akce" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                    <Template>
                        @{
                            var model = (context as AreaListViewModel);
                            <div class="action-buttons">
                                <SfButton CssClass="e-small e-round e-outline action-button"
                                          IconCss="e-icons e-edit"
                                          IsPrimary="false"
                                          OnClick="@(() => EditArea(model!))"
                                          title="Editovat">
                                </SfButton>
                            </div>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
</div>

<SfToast @ref="ToastObj" Title="Zkopírováno" Timeout="3000" ShowCloseButton="true">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

@if (IsLoading)
{
    <div class="progress-bar-container">
        <div class="progress-bar-indeterminate"></div>
    </div>
}

@code {
    SfGrid<AreaListViewModel>? Grid;
    SfToast? ToastObj;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        await ShowToast($"ID zkopírováno: {text.Substring(0, 8)}...");
    }

    private async Task ShowToast(string message)
    {
        if (ToastObj != null)
        {
            var toastModel = new ToastModel
            {
                Content = message,
                CssClass = "e-toast-success",
                Icon = "e-success toast-icons"
            };
            await ToastObj.ShowAsync(toastModel);
        }
    }

    private void EditArea(AreaListViewModel area)
    {
        NavigationManager.NavigateTo($"/areaedit/{area.Code}");
    }
}
