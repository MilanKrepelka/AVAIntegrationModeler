@page "/"
@rendermode InteractiveServer
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Cards
@using AVAIntegrationModeler.Web.SyncfusionApp.Services
@using AVAIntegrationModeler.Contracts.DTO
@using AVAIntegrationModeler.API.Client
@inject IntegrationHintService HintService
@inject IAVAIntegrationModelerApiClient ApiClient

<PageTitle>AVA Integration Modeler</PageTitle>

<span class="pageheader">AVA Integration Modeler</span>

<h4 class="section-title">Poslední nasazení</h4>

@if (_isLoadingDeployments)
{
    <p class="loading-text">Načítám nasazení…</p>
}
else if (_recentDeployments.Count == 0)
{
    <p class="loading-text">Žádná nasazení nebyla nalezena.</p>
}
else
{
    <div class="deployments-row">
        @foreach (var d in _recentDeployments)
        {
            <SfCard CssClass="deployment-card">
                <CardHeader Title="@d.Code" SubTitle="@d.Name" />
                <CardContent>
                    @if (!string.IsNullOrWhiteSpace(d.Ticket))
                    {
                        <div class="dep-row"><span class="dep-label">Ticket</span><span>@d.Ticket</span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(d.Description))
                    {
                        <div class="dep-row dep-desc">@d.Description</div>
                    }
                    <div class="dep-row"><span class="dep-label">Datové modely</span><span>@d.DataModelIds.Count</span></div>
                </CardContent>
                <CardFooter>
                    <a href="/deploymentedit/@d.Code" class="dep-edit-link" title="Upravit nasazení @d.Code">
                        <span class="e-icons e-edit"></span> Upravit
                    </a>
                </CardFooter>
            </SfCard>
        }
    </div>
}

<p class="pagecontent">Pravidla integrační architektury — tip dne</p>

<div class="hint-carousel-wrapper">
    <SfCarousel Width="100%" AnimationEffect="CarouselAnimationEffect.Slide" ButtonsVisibility="CarouselButtonVisibility.Visible" ShowIndicators="true" CssClass="hint-carousel" Interval="10000">
        @foreach (var hint in HintService.GetHints())
        {
            <CarouselItem>
                <div class="hint-slide">
                    <h5 class="hint-number">Hint @hint.Number / @HintService.GetHints().Count</h5>
                    <h4 class="hint-title">@hint.Title</h4>
                    <ul>
                        @foreach (var point in hint.Points)
                        {
                            <li>@point</li>
                        }
                    </ul>
                </div>
            </CarouselItem>
        }
    </SfCarousel>
</div>


<style>
    .pageheader {
        font-family: sans-serif !important;
        font-size: 24px !important;
        color: #333333;
        font-weight: bold !important;
    }

    .pagecontent {
        font-family: sans-serif !important;
        font-size: 16px;
        color: #333333;
        letter-spacing: 0.34px;
        line-height: 24px;
        margin-top: 10px;
        margin-bottom: 20px;
    }

    .hint-carousel-wrapper {
        max-width: 900px;
        margin-bottom: 36px;
    }

    .hint-carousel .e-carousel-items .e-carousel-item {
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
    }

    .hint-slide {
        font-family: sans-serif !important;
        font-size: 15px;
        color: #333333;
        line-height: 22px;
        padding: 32px 48px;
        width: 100%;
        box-sizing: border-box;
        overflow-y: auto;
        height: 100%;
    }

    .hint-number {
        font-family: sans-serif !important;
        font-size: 12px;
        color: #888;
        font-weight: normal;
        margin: 0 0 6px 0;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .hint-title {
        font-family: sans-serif !important;
        font-size: 18px;
        font-weight: bold;
        color: #1a1a2e;
        margin: 0 0 16px 0;
    }

    .hint-slide ul {
        padding-left: 20px;
        margin: 0;
    }

    .hint-slide li {
        margin-bottom: 8px;
    }

    .section-title {
        font-family: sans-serif !important;
        font-size: 18px;
        font-weight: bold;
        color: #333333;
        margin: 0 0 16px 0;
    }

    .loading-text {
        font-family: sans-serif !important;
        font-size: 14px;
        color: #888;
    }

    .deployments-row {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        max-width: 1100px;
        margin-bottom: 24px;
    }

    .deployment-card {
        flex: 1 1 200px;
        min-width: 180px;
        max-width: 260px;
        font-family: sans-serif !important;
        font-size: 14px;
    }

    .dep-row {
        display: flex;
        gap: 8px;
        margin-bottom: 4px;
        font-size: 13px;
        color: #444;
    }

    .dep-label {
        color: #888;
        min-width: 80px;
        flex-shrink: 0;
    }

    .dep-desc {
        color: #555;
        font-size: 12px;
        line-height: 18px;
        display: block;
        margin-top: 4px;
    }

    .dep-edit-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
        color: #0d6efd;
        text-decoration: none;
    }

    .dep-edit-link:hover {
        color: #0a58ca;
        text-decoration: underline;
    }
</style>

@code {
    private List<DeploymentDTO> _recentDeployments = [];
    private bool _isLoadingDeployments = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await ApiClient.GetRecentDeployments(5, CancellationToken.None);
            _recentDeployments = response.Deployments;
        }
        catch
        {
            _recentDeployments = [];
        }
        finally
        {
            _isLoadingDeployments = false;
        }
    }
}
