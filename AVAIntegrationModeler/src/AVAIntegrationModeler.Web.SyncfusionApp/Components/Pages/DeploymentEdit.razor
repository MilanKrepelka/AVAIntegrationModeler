@page "/deploymentedit/{deploymentCode}"
@page "/deploymentedit"
@rendermode InteractiveServer
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Microsoft.AspNetCore.Components.Forms
@using AVAIntegrationModeler.Contracts.DTO

<EditForm Model="_edit" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <h2>@(IsEditMode ? Localization.SharedResources.Deployments_EditTitle : Localization.SharedResources.Deployments_NewTitle)</h2>

        <div class="row">
            <div class="col-12 col-md-6">
                <SfTextBox CssClass="w-100"
                           Placeholder="@Localization.SharedResources.Deployments_CodePlaceholder"
                           FloatLabelType="FloatLabelType.Always"
                           @bind-Value="_edit.Code">
                </SfTextBox>
                <ValidationMessage For="@(() => _edit.Code)" />
            </div>
            <div class="col-12 col-md-6">
                <SfTextBox CssClass="w-100"
                           Placeholder="@Localization.SharedResources.Identifier"
                           FloatLabelType="FloatLabelType.Always"
                           @bind-Value="_edit.IdText"
                           Readonly="true">
                </SfTextBox>
            </div>
        </div>

        <div class="row" style="margin-top:16px">
            <div class="col-12">
                <SfTextBox CssClass="w-100"
                           Placeholder="@Localization.SharedResources.Deployments_NamePlaceholder"
                           FloatLabelType="FloatLabelType.Always"
                           @bind-Value="_edit.Name">
                </SfTextBox>
                <ValidationMessage For="@(() => _edit.Name)" />
            </div>
        </div>

        <div class="row" style="margin-top:16px">
            <div class="col-12">
                <SfTextBox CssClass="w-100"
                           Placeholder="@Localization.SharedResources.Deployments_TicketPlaceholder"
                           FloatLabelType="FloatLabelType.Always"
                           @bind-Value="_edit.Ticket">
                </SfTextBox>
                <ValidationMessage For="@(() => _edit.Ticket)" />
            </div>
        </div>

        <div class="row" style="margin-top:16px">
            <div class="col-12">
                <SfTextBox CssClass="w-100"
                           Placeholder="@Localization.SharedResources.Deployments_DescriptionPlaceholder"
                           FloatLabelType="FloatLabelType.Always"
                           Multiline="true"
                           @bind-Value="_edit.Description">
                </SfTextBox>
                <ValidationMessage For="@(() => _edit.Description)" />
            </div>
        </div>

        @if (IsEditMode)
        {
            <div class="row" style="margin-top:16px">
                <div class="col-12 col-md-6">
                    <SfTextBox CssClass="w-100"
                               Placeholder="@Localization.SharedResources.Deployments_LastSave"
                               FloatLabelType="FloatLabelType.Always"
                               Value="@(_edit.LastSaveDateTime.HasValue ? _edit.LastSaveDateTime.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") : "")"
                               Readonly="true">
                    </SfTextBox>
                </div>
                <div class="col-12 col-md-6">
                    <SfTextBox CssClass="w-100"
                               Placeholder="@Localization.SharedResources.Deployments_LastDeployment"
                               FloatLabelType="FloatLabelType.Always"
                               Value="@(_edit.LastDeploymentDateTime.HasValue ? _edit.LastDeploymentDateTime.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") : "")"
                               Readonly="true">
                    </SfTextBox>
                </div>
            </div>
        }

        <div class="row" style="margin-top:24px">
            <div class="col-12">
                <h5>@Localization.SharedResources.Deployments_DataModelsInDeployment</h5>

                @if (_edit.DataModelIds.Count == 0)
                {
                    <p class="text-muted">@Localization.SharedResources.Deployments_NoDataModels</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>@Localization.SharedResources.Common_Code</th>
                                <th>@Localization.SharedResources.Common_Name</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var id in _edit.DataModelIds.ToList())
                            {
                                var dm = _availableDataModels.FirstOrDefault(m => m.Id == id);
                                <tr>
                                    <td>@(dm?.Code ?? id.ToString())</td>
                                    <td>@(dm?.Name ?? "")</td>
                                    <td style="white-space:nowrap">
                                        <SfButton CssClass="e-small e-outline"
                                                  IconCss="e-icons e-eye"
                                                  Type="Button"
                                                  title="@Localization.SharedResources.DataModels_CompareDbVsAvaPlace"
                                                  OnClick="@(() => NavigationManager.NavigateTo($"/datamodelchanges/{id}"))">
                                        </SfButton>
                                        <SfButton CssClass="e-small e-danger e-outline"
                                                  Type="Button"
                                                  OnClick="@(() => RemoveDataModel(id))">
                                            @Localization.SharedResources.Common_Remove
                                        </SfButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <div class="d-flex gap-2 align-items-center" style="margin-top:8px">
                    <SfDropDownList TItem="DataModelDTO"
                                    TValue="Guid"
                                    DataSource="@_selectableDataModels"
                                    @bind-Value="_selectedDataModelId"
                                    Placeholder="@Localization.SharedResources.Deployments_SelectDataModel"
                                    AllowFiltering="true"
                                    FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                    IgnoreAccent="true"
                                    FilterBarPlaceholder="@Localization.SharedResources.Deployments_SearchModel"
                                    CssClass="w-50">
                        <DropDownListFieldSettings Text="Code" Value="Id"></DropDownListFieldSettings>
                    </SfDropDownList>
                    <SfButton CssClass="e-primary" Type="Button" OnClick="AddDataModel">@Localization.SharedResources.Common_Add</SfButton>
                </div>
            </div>
        </div>

        @if (_saveMessage is not null)
        {
            <div class="alert @(_saveSuccess ? "alert-success" : "alert-danger")" style="margin-top:16px">
                @_saveMessage
            </div>
        }

        @if (IsEditMode)
        {
            <div class="row" style="margin-top:24px">
                <div class="col-12">
                    <h5>@Localization.SharedResources.Deployments_ChangesSummaryTitle</h5>

                    @if (!_loadingSummary && _changesSummary is null && _summaryError is null)
                    {
                        <SfButton CssClass="e-outline e-small" Type="Button" OnClick="LoadChangesSummaryAsync">
                            @Localization.SharedResources.Deployments_LoadChangesSummary
                        </SfButton>
                    }

                    @if (_loadingSummary)
                    {
                        <div class="text-muted" style="font-size:.875rem">@Localization.SharedResources.Common_Loading</div>
                    }

                    @if (_summaryError is not null)
                    {
                        <div class="alert alert-danger" style="padding:.4rem .8rem; font-size:.875rem">@_summaryError</div>
                        <SfButton CssClass="e-outline e-small" Type="Button" OnClick="LoadChangesSummaryAsync">@Localization.SharedResources.Common_TryAgain</SfButton>
                    }

                    @if (_changesSummary is { } s)
                    {
                        <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:12px; font-size:.875rem">
                            <span style="color:#198754; font-weight:600">@string.Format(Localization.SharedResources.Deployments_StatusSameLabel, s.ModelsSame)</span>
                            <span style="color:#dc3545; font-weight:600">@string.Format(Localization.SharedResources.Deployments_StatusDifferentLabel, s.ModelsDifferent)</span>
                            @if (s.ModelsOnlyInDatabase > 0)
                            {
                                <span style="color:#0d6efd; font-weight:600">@string.Format(Localization.SharedResources.Deployments_StatusOnlyDbLabel, s.ModelsOnlyInDatabase)</span>
                            }
                            @if (s.ModelsOnlyInAvaPlace > 0)
                            {
                                <span style="color:#6f42c1; font-weight:600">@string.Format(Localization.SharedResources.Deployments_StatusOnlyAvaLabel, s.ModelsOnlyInAvaPlace)</span>
                            }
                            <SfButton CssClass="e-outline e-small" Type="Button" OnClick="LoadChangesSummaryAsync" style="margin-left:auto">
                                @Localization.SharedResources.Common_Refresh
                            </SfButton>
                        </div>

                        <table class="table table-sm table-hover" style="font-size:.875rem">
                            <thead class="table-light">
                                <tr>
                                    <th>@Localization.SharedResources.Common_Code</th>
                                    <th>@Localization.SharedResources.Common_Name</th>
                                    <th>@Localization.SharedResources.Deployments_StatusColumn</th>
                                    <th title="@Localization.SharedResources.Deployments_FieldsDeltaTitle">@Localization.SharedResources.Deployments_FieldsDelta</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in s.Models)
                                {
                                    <tr>
                                        <td>@item.Code</td>
                                        <td>@item.Name</td>
                                        <td>
                                            @switch (item.Status)
                                            {
                                                case AVAIntegrationModeler.Contracts.DataModels.ComparisonStatus.Same:
                                                    <span style="color:#198754">@Localization.SharedResources.Deployments_StatusSame</span>
                                                    break;
                                                case AVAIntegrationModeler.Contracts.DataModels.ComparisonStatus.Different:
                                                    <span style="color:#dc3545">@Localization.SharedResources.Deployments_StatusDifferent</span>
                                                    break;
                                                case AVAIntegrationModeler.Contracts.DataModels.ComparisonStatus.OnlyInDatabase:
                                                    <span style="color:#0d6efd">@Localization.SharedResources.Deployments_StatusOnlyDb</span>
                                                    break;
                                                case AVAIntegrationModeler.Contracts.DataModels.ComparisonStatus.OnlyInAvaPlace:
                                                    <span style="color:#6f42c1">@Localization.SharedResources.Deployments_StatusOnlyAvaPlace</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @if (item.FieldsDifferent > 0 || item.FieldsOnlyInDatabase > 0 || item.FieldsOnlyInAvaPlace > 0)
                                            {
                                                @if (item.FieldsDifferent > 0)
                                                {
                                                    <span style="color:#dc3545; margin-right:4px">⚡@item.FieldsDifferent</span>
                                                }
                                                @if (item.FieldsOnlyInDatabase > 0)
                                                {
                                                    <span style="color:#0d6efd; margin-right:4px">+@item.FieldsOnlyInDatabase DB</span>
                                                }
                                                @if (item.FieldsOnlyInAvaPlace > 0)
                                                {
                                                    <span style="color:#6f42c1">+@item.FieldsOnlyInAvaPlace AVA</span>
                                                }
                                            }
                                            else
                                            {
                                                <span style="color:#6c757d">—</span>
                                            }
                                        </td>
                                        <td>
                                            <SfButton CssClass="e-small e-outline"
                                                      IconCss="e-icons e-eye"
                                                      Type="Button"
                                                      title="@Localization.SharedResources.Deployments_DetailChanges"
                                                      OnClick="@(() => NavigateToModelChanges(item.DataModelId))">
                                            </SfButton>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }

        @if (IsEditMode)
        {
            <div style="margin-top:16px; display:flex; gap:8px; flex-wrap:wrap">
                <SfButton CssClass="e-outline" Type="Button" OnClick="ExportAsync">
                    @Localization.SharedResources.Deployments_ExportDataModels
                </SfButton>
                <SfButton CssClass="e-success e-outline" Type="Button" OnClick="UploadToAvaPlaceAsync" Disabled="@_avaPlaceLoading">
                    @(_avaPlaceLoading ? Localization.SharedResources.Deployments_Uploading : Localization.SharedResources.Deployments_UploadToAvaPlace)
                </SfButton>
            </div>
            @if (_avaPlaceMessage is not null)
            {
                <div class="alert @(_avaPlaceSuccess ? "alert-success" : "alert-danger")" style="margin-top:8px; font-size:.875rem">
                    @_avaPlaceMessage
                </div>
            }
        }

        <div style="margin-top:16px; display:flex; gap:8px">
            <SfButton CssClass="e-primary" HtmlAttributes="@(new Dictionary<string, object> { { "type", "submit" } })">@Localization.SharedResources.Common_Save</SfButton>
            <SfButton CssClass="e-outline" Type="Button" OnClick="GoBack">@Localization.SharedResources.Common_Back</SfButton>
        </div>
    </div>
</EditForm>
