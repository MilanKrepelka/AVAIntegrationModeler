<ItemGroup>
  <Content Update="wwwroot\app-theme-ava.css">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <Content Update="wwwroot\control-badge.css">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <Content Update="wwwroot\control-btn.css">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <Content Update="wwwroot\control-radio-button.css">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <Content Update="wwwroot\control-checkbox.css">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <Content Update="wwwroot\control-grid.css">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>
<ItemGroup>
  <Folder Include="ViewModels\Scenarios\" />
</ItemGroup>
<ItemGroup>
  <ProjectReference Include="..\AVAIntegrationModeler.API.Client\AVAIntegrationModeler.API.Client.csproj" />
  <ProjectReference Include="..\AVAIntegrationModeler.Contracts\AVAIntegrationModeler.Contracts.csproj" />
  <ProjectReference Include="..\AVAIntegrationModeler.Domain\AVAIntegrationModeler.Domain.csproj" />
</ItemGroup>
<ItemGroup>
  <Compile Update="SharedResources.Designer.cs">
    <DependentUpon>SharedResources.resx</DependentUpon>
    <DesignTime>True</DesignTime>
    <AutoGen>True</AutoGen>
  </Compile>
</ItemGroup>
<ItemGroup>
  <EmbeddedResource Update="SharedResources.cs.resx">
    <DependentUpon>SharedResources.resx</DependentUpon>
    <Generator>PublicResXFileCodeGenerator</Generator>
  </EmbeddedResource>
  <EmbeddedResource Update="SharedResources.resx">
    <SubType>Designer</SubType>
    <LastGenOutput>SharedResources.Designer.cs</LastGenOutput>
    <Generator>PublicResXFileCodeGenerator</Generator>
  </EmbeddedResource>
</ItemGroup>

  

</Project>
